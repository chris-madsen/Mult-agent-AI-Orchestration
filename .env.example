# Google Vertex AI project used by Architect/Critic agents
# `make start` tries to auto-fill this from `gcloud config get-value project`
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Optional, defaults to global if omitted
GOOGLE_CLOUD_LOCATION=global
# If LOCATION is `global`, AutoGen Gemini resolves to CONSILIUM_VERTEX_GEMINI_REGION (default us-central1).
#CONSILIUM_VERTEX_GEMINI_REGION=us-central1
# Anthropic Claude on Vertex uses a regional endpoint; if LOCATION is `global`, this is used (default us-east5).
#CONSILIUM_VERTEX_ANTHROPIC_REGION=us-east5

# Consilium OpenAI-compatible gateway auth key (used by Cursor custom OpenAI provider)
# `make start` auto-generates a strong key if placeholder/default is still set
CONSILIUM_API_KEY=replace-with-strong-key

# Optional strict mode: fail startup if default gateway API key is used
CONSILIUM_STRICT_API_KEY=1

# Public model alias exposed via OpenAI `/v1/models` to Cursor.
# Internal Consilium routing remains dynamic and model-agnostic.
CONSILIUM_PUBLIC_MODEL=consilium-auto
# Optional additional aliases exposed via `/v1/models` (comma/space-separated).
# Default in gateway includes gpt-5.3-codex even if this variable is empty.
# CONSILIUM_PUBLIC_MODEL_ALIASES=gpt-5.3-codex

# Optional: Gateway-only provider/model override for chat responsiveness.
# If unset, gateway uses roles.implementer from .consilium/policies/model_config.yaml.
# Recommended for MVP chat: codex-cli + gpt-5.3-codex (Vertex can be slower / misconfigured).
CONSILIUM_GATEWAY_PROVIDER=google
CONSILIUM_GATEWAY_MODEL=gemini-2.5-pro
# Optional HTTP timeouts for Vertex wrapper (seconds).
# Increase max time for larger prompts/models to avoid premature curl timeouts.
CONSILIUM_VERTEX_HTTP_CONNECT_TIMEOUT_SEC=10
CONSILIUM_VERTEX_HTTP_MAX_TIME_SEC=120

# Optional Ralphex command override for gateway transport
# Default is auto-detected binary in plan-file mode:
#   review mode:  /abs/path/to/ralphex --review "$CONSILIUM_PLAN_FILE"
#   execute mode: /abs/path/to/ralphex "$CONSILIUM_PLAN_FILE"
CONSILIUM_RALPHEX_CMD=

# Gateway transport mode: auto | tasks | execute | review
# Request-level routing profile is applied in gateway:
# - Codex Plan mode -> ralphex tasks-only with architect model
# - non-Plan mode -> ralphex standard execute pipeline
CONSILIUM_RALPHEX_MODE=tasks

# Optional gateway transport timeout (seconds)
CONSILIUM_RALPHEX_TIMEOUT_SEC=1200

# Optional: idle timeout without any subprocess output (seconds, 0 disables)
CONSILIUM_RALPHEX_IDLE_TIMEOUT_SEC=300

# Optional: execute-profile idle timeout (non-Plan route). If unset, gateway uses max(global idle, 900).
# Increase if long review phases are killed as false "ralphex stalled" events.
CONSILIUM_RALPHEX_EXECUTE_IDLE_TIMEOUT_SEC=900

# Optional: heartbeat period for "thinking vs stuck" telemetry in gateway logs/healthz
CONSILIUM_RALPHEX_HEARTBEAT_SEC=15

# Optional: mark run phase as "running_no_output" after this idle threshold (seconds)
CONSILIUM_RALPHEX_IDLE_WARN_SEC=45

# Request profile iteration limits:
# - Plan mode profile (tasks-only)
CONSILIUM_RALPHEX_PLAN_MAX_ITERATIONS=2
# - non-Plan profile (standard execute pipeline)
CONSILIUM_RALPHEX_STANDARD_MAX_ITERATIONS=24

# Chat-specific session/idle ceilings for Plan mode tasks-only profile
CONSILIUM_RALPHEX_CHAT_SESSION_TIMEOUT_SEC=60
CONSILIUM_RALPHEX_CHAT_IDLE_TIMEOUT_SEC=30
# Chat-mode iterations for non-coding requests in default mode (tasks-only profile).
CONSILIUM_RALPHEX_CHAT_MAX_ITERATIONS=1
# Repo-read chat requests (e.g. "show project files", "working directory") need 2 loops
# so the first loop can inspect files and the second can emit a stable final answer.
CONSILIUM_RALPHEX_REPO_READ_MAX_ITERATIONS=2
# Preflight cleanup for hung `running_no_output` runs before next request.
CONSILIUM_RALPHEX_NO_OUTPUT_STALE_MAX_SEC=45

# Optional emergency fallback to direct `codex exec` (disabled by default):
# keep `0` if you want all user-visible responses to stay on the ralphex route.
CONSILIUM_GATEWAY_ENABLE_DIRECT_CODEX_FALLBACK=0
# Optional limit fallback (enabled by default in gateway code):
# if enabled and Codex path hits quota/rate limits, gateway retries via Gemini.
CONSILIUM_GATEWAY_ENABLE_LIMIT_FALLBACK_TO_GEMINI=1
CONSILIUM_GATEWAY_LIMIT_FALLBACK_MODEL=gemini-2.5-pro
# `ralphex` keeps fallback inside ralphex runtime (recommended for tool/file access).
# `direct` uses legacy direct Vertex Q/A fallback.
CONSILIUM_GATEWAY_LIMIT_FALLBACK_ROUTE=ralphex
# Keep strict ralphex orchestration (all model calls through ralphex).
CONSILIUM_GATEWAY_STRICT_RALPHEX_ONLY=1
# Optional emergency escape hatch: if strict mode is disabled, allow one direct Vertex recovery pass.
CONSILIUM_GATEWAY_LIMIT_FALLBACK_ALLOW_DIRECT_RECOVERY=0
# Dedicated ralphex fallback timeouts (Gemini-on-limit path). Keep idle > 30s to avoid false stalls.
CONSILIUM_GATEWAY_LIMIT_FALLBACK_CHAT_SESSION_TIMEOUT_SEC=90
CONSILIUM_GATEWAY_LIMIT_FALLBACK_CHAT_IDLE_TIMEOUT_SEC=60

# Block mutating git operations (commit/push/rebase/merge/...) inside gateway chat runtime.
# Keep enabled to avoid unexpected history changes from autonomous runs.
CONSILIUM_GATEWAY_BLOCK_GIT_COMMITS=1

# Progress trace visibility for responses where ralphex produced logs but no final answer.
# Keep enabled to debug runtime failures in the same UI where requests are sent.
CONSILIUM_GATEWAY_EXPOSE_PROGRESS_TRACE=1
# Optional: include progress trace even on successful answers with `Final answer:`.
CONSILIUM_GATEWAY_EXPOSE_PROGRESS_TRACE_SUCCESS=1
# Optional trace clipping controls.
CONSILIUM_GATEWAY_PROGRESS_TRACE_MAX_LINES=140
CONSILIUM_GATEWAY_PROGRESS_TRACE_MAX_CHARS=14000

# Optional: auto-bootstrap git for ralphex in make ensure-gateway
# (runs `git init` and creates empty commit if needed)
CONSILIUM_AUTO_GIT_INIT=1
