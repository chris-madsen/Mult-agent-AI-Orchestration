# Google Vertex AI project used by Architect/Critic agents
# `make start` tries to auto-fill this from `gcloud config get-value project`
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Optional, defaults to global if omitted
GOOGLE_CLOUD_LOCATION=global

# Consilium OpenAI-compatible gateway auth key (used by Cursor custom OpenAI provider)
# `make start` auto-generates a strong key if placeholder/default is still set
CONSILIUM_API_KEY=replace-with-strong-key

# Optional strict mode: fail startup if default gateway API key is used
CONSILIUM_STRICT_API_KEY=1

# Public model alias exposed via OpenAI `/v1/models` to Cursor.
# Internal Consilium routing remains dynamic and model-agnostic.
CONSILIUM_PUBLIC_MODEL=consilium-auto

# Optional Ralphex command override for gateway transport
# Default is auto-detected binary in plan-file mode:
#   review mode:  /abs/path/to/ralphex --review "$CONSILIUM_PLAN_FILE"
#   execute mode: /abs/path/to/ralphex "$CONSILIUM_PLAN_FILE"
CONSILIUM_RALPHEX_CMD=

# Gateway transport mode: auto | tasks | execute | review
# - auto: review-like prompts -> review mode, otherwise execute mode
# - connectivity probes (ping/health) are handled by fast gateway probe path
CONSILIUM_RALPHEX_MODE=auto

# Optional gateway transport timeout (seconds)
CONSILIUM_RALPHEX_TIMEOUT_SEC=1200

# Optional: idle timeout without any subprocess output (seconds, 0 disables)
CONSILIUM_RALPHEX_IDLE_TIMEOUT_SEC=300

# Optional: heartbeat period for "thinking vs stuck" telemetry in gateway logs/healthz
CONSILIUM_RALPHEX_HEARTBEAT_SEC=15

# Optional: mark run phase as "running_no_output" after this idle threshold (seconds)
CONSILIUM_RALPHEX_IDLE_WARN_SEC=45

# Optional: auto-bootstrap git for ralphex in make ensure-gateway
# (runs `git init` and creates empty commit if needed)
CONSILIUM_AUTO_GIT_INIT=1
