{
  "name": "ace-harness",
  "version": "0.1.0",
  "private": true,
  "description": "Adaptive Context Engine foundation",
  "type": "module",
  "scripts": {
    "build": "node --input-type=module -e \"import {rmSync} from 'node:fs'; rmSync('dist',{recursive:true,force:true}); rmSync('.cache/tsconfig.tsbuildinfo',{force:true})\" && tsc -p tsconfig.json && node scripts/generate-runtime-provenance.mjs",
    "context:rpc": "npm run build && node dist/bin/ace-context-rpc.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "check:public-contract-types": "tsc -p tsconfig.public-contracts.json --noEmit",
    "lint": "eslint src test --ext .ts --max-warnings=0",
    "analyze:dependencies": "knip --no-progress --reporter compact --no-exit-code",
    "probe:providers": "node scripts/provider-capability-probe.mjs",
    "report:harbor-smoke": "tsx scripts/render-harbor-smoke-report.ts",
    "report:harbor-retrieval": "tsx scripts/render-harbor-retrieval-report.ts",
    "spike:embeddings": "tsx scripts/embedding-spike.ts",
    "recall:codex-history": "tsx scripts/recall-codex-history.ts",
    "probe:vertex": "bash scripts/vertex-rag-readonly-probe.sh",
    "test:memory-process": "npm run build && node scripts/memory-process-e2e.mjs",
    "preflight:feedback-loop": "tsx scripts/feedback-loop-preflight.ts",
    "freeze:feedback-local": "tsx scripts/freeze-local-feedback-task.ts",
    "build:harbor-runtime": "node scripts/build-harbor-ace-runtime.mjs",
    "test:ace-container-runtime": "node scripts/ace-container-runtime-smoke.mjs",
    "acquire:repobench-r": "tsx scripts/repobench-r-acquire.ts",
    "convert:repobench-r": "python3 scripts/repobench-r-pickle-to-json.py",
    "convert:repobench-r-parquet": "python3 scripts/repobench-r-parquet-to-json.py",
    "resolve:repobench-r": "tsx scripts/repobench-r-resolve-context.ts",
    "adapt:repobench-r": "tsx scripts/repobench-r-adapter.ts",
    "freeze:feedback-tasks": "tsx scripts/freeze-feedback-task-manifest.ts",
    "harbor:task-identities": "tsx scripts/harbor-task-identities.ts",
    "collect:feedback-loop": "tsx scripts/collect-feedback-loop.ts",
    "report:feedback-summary": "tsx scripts/render-feedback-summary.ts",
    "probe:jev": "bash scripts/jev-readonly-probe.sh",
    "test": "tsx --test test/*.test.ts",
    "memory:sync": "npm run build && node dist/bin/ace-memory.js",
    "test:real-same-name": "npm run build && tsx scripts/real-same-name-lsp-e2e.ts",
    "test:real-non-ts-lsp": "npm run build && tsx scripts/non-ts-lsp-conformance.ts",
    "compare:embeddings": "bash scripts/embedding-provider-comparison.sh",
    "memory:reconcile": "npm run build && node dist/bin/ace-memory.js reconcile",
    "worktree-helper": "npm run build && node dist/bin/ace-worktree-helper.js",
    "worktree:audit": "node scripts/git-worktree-lifecycle.mjs audit",
    "worktree:preflight": "node scripts/git-worktree-lifecycle.mjs preflight",
    "worktree:start": "node scripts/git-worktree-lifecycle.mjs start",
    "worktree:status": "node scripts/git-worktree-lifecycle.mjs status",
    "worktree:cleanup": "node scripts/git-worktree-lifecycle.mjs cleanup",
    "eval:memory-admission": "tsx scripts/memory-admission-eval.ts",
    "eval:reranker": "tsx scripts/reranker-evaluation.ts",
    "freeze:reranker-holdout": "tsx scripts/freeze-reranker-holdout.ts",
    "convert:reranker-holdout": "tsx scripts/reranker-holdout-to-retrieval-holdout.ts",
    "baseline:reranker": "tsx scripts/reranker-baseline-from-retrieval.ts",
    "gate:reranker-selection": "tsx scripts/reranker-selection-gate.ts",
    "gate:harbor-three-arm": "tsx scripts/harbor-three-arm-gate.ts",
    "gate:harbor-four-arm": "tsx scripts/harbor-four-arm-gate.ts",
    "verify:harbor-four-arm-binding": "tsx scripts/verify-harbor-four-arm-binding.ts",
    "freeze:harbor-four-arm": "tsx scripts/freeze-harbor-four-arm-jobs.ts",
    "vertex:import-synthetic": "bash scripts/vertex-synthetic-fixture-import.sh",
    "test:real-vertex-conflict": "tsx scripts/vertex-synthetic-conflict-e2e.ts",
    "evidence:dbc": "tsx scripts/dbc-evidence-manifest.ts",
    "gate:embedding-selection": "tsx scripts/embedding-selection-gate.ts",
    "compare:semantic-tsls": "tsx scripts/typescript-ls-semantic-comparison.ts",
    "gate:semantic-selection": "tsx scripts/semantic-provider-selection-gate.ts",
    "report:retrieval-quality": "tsx scripts/retrieval-quality-report.ts",
    "gate:retrieval-quality": "tsx scripts/retrieval-quality-gate.ts",
    "freeze:retrieval-holdout": "tsx scripts/freeze-retrieval-holdout.ts",
    "validate:retrieval-holdout": "tsx scripts/validate-retrieval-holdout.ts",
    "probe:retrieval-rank": "tsx scripts/qdrant-hybrid-rank-probe.ts",
    "merge:retrieval-runs": "tsx scripts/merge-retrieval-runs.ts",
    "gate:retrieval-ablation": "tsx scripts/retrieval-ablation-gate.ts",
    "release:preflight": "tsx scripts/release-preflight.ts",
    "memory:backup": "tsx scripts/local-memory-backup.ts",
    "release:supply-chain": "tsx scripts/supply-chain-evidence.ts",
    "release:preflight-code": "tsx scripts/code-release-preflight.ts",
    "evidence:k3s-worktree": "tsx scripts/k3s-worktree-evidence.ts",
    "test:real-k3s-worktree": "npm run build && node scripts/k3s-worktree-real-e2e.mjs",
    "evidence:backup-restore": "tsx scripts/backup-restore-evidence.ts",
    "evidence:resource-budget": "tsx scripts/resource-budget-evidence.ts",
    "evidence:runtime-config": "tsx scripts/runtime-config-evidence.ts",
    "test:fast": "npm run test:affected",
    "test:affected": "node scripts/run-affected-tests.mjs",
    "test:impact:self": "node scripts/run-affected-tests.mjs --self-test",
    "test:arch-rules": "ast-grep test --config architecture/sgconfig.yml --skip-snapshot-tests --color=never",
    "check:arch": "ast-grep scan --color=never --rule architecture/rules/ace-domain-no-adapter-import.yml src/domain && ast-grep scan --color=never --rule architecture/rules/ace-application-no-adapter-import.yml src/application && ast-grep scan --color=never --rule architecture/rules/ace-domain-no-application-import.yml src/domain && ast-grep scan --color=never --rule architecture/rules/ace-domain-no-provider-io-import.yml src/domain",
    "verify:pr": "npm run check && npm run test:impact:self && npm run test:affected && npm run lint && npm run test:gateway-only-audit && npm run check:gateway-only && npm run check:bifrost-context && npm run test:arch-rules && npm run check:arch && npm run test:sdlc-preflight && npm run test:matt-pocock-skill-vendor && npm run test:ace-sdlc-pipeline && npm run test:ace-plan-refinement && npm run test:sdlc-stage-trial && npm run test:sdd-prepare && npm run test:sdlc-closure && npm run check:sdlc-closure",
    "verify:pr:affected": "npm run verify:pr",
    "verify:full": "npm run check && npm test && npm run lint && npm run build && npm run test:gateway-only-audit && npm run check:gateway-only && npm run check:bifrost-context && npm run test:arch-rules && npm run check:arch && npm run test:sdlc-preflight && npm run test:matt-pocock-skill-vendor && npm run test:ace-plan-refinement && npm run test:sdlc-stage-trial && npm run test:sdd-prepare && npm run test:sdlc-closure && npm run check:sdlc-closure && ./node_modules/.bin/tsx --test test/nightly/gateway-projection.property.test.ts",
    "sdlc:preflight": "node scripts/sdlc-preflight.mjs",
    "test:sdlc-preflight": "node --test test/sdlc-preflight.test.mjs",
    "test:matt-pocock-skill-vendor": "node --test test/matt-pocock-skill-vendor.test.mjs",
    "test:ace-sdlc-pipeline": "node --test test/ace-sdlc-pipeline.test.mjs",
    "check:ace-phase-plan": "node scripts/ace-phase-plan-check.mjs",
    "check:gateway-only": "node scripts/gateway-only-audit.mjs",
    "check:bifrost-context": "node scripts/bifrost-single-gateway-audit.mjs",
    "test:gateway-only-audit": "node --test test/gateway-only-audit.test.mjs",
    "check:sdlc-closure": "node scripts/sdlc-closure-audit.mjs",
    "test:sdlc-closure": "node --test test/sdlc-closure-audit.test.mjs",
    "test:real-projection": "npm run build && node scripts/real-projection-e2e.mjs",
    "receipt:responses-stream": "tsx scripts/native-responses-stream-receipt.ts",
    "test:real-projection-race": "npm run build && ACE_REAL_PROJECTION_RACE=true node scripts/real-projection-e2e.mjs",
    "test:real-projection-outage": "npm run build && ACE_REAL_PROJECTION_OUTAGE=true node scripts/real-projection-e2e.mjs",
    "test:real-projection-hard-outage": "npm run build && ACE_REAL_PROJECTION_HARD_OUTAGE=true node scripts/real-projection-e2e.mjs",
    "test:mutation:critical": "node scripts/nightly-targeted-mutation.mjs",
    "check:sdd-prepare": "node scripts/sdd-preparation-check.mjs",
    "test:sdd-prepare": "node --test test/sdd-preparation-check.test.mjs",
    "check:sdlc-stage-trial": "node scripts/ace-sdlc-stage-trial-check.mjs",
    "test:sdlc-stage-trial": "node --test test/ace-sdlc-stage-trial.test.mjs",
    "test:ace-plan-refinement": "node --test test/ace-plan-refinement.test.mjs"
  },
  "dependencies": {
    "@ast-grep/cli": "0.51.0",
    "@qdrant/js-client-rest": "1.20.0",
    "effect": "3.22.3",
    "typescript": "5.9.3",
    "typescript-language-server": "6.0.2",
    "vscode-jsonrpc": "9.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "eslint": "8.57.1",
    "eslint-config-airbnb-typescript": "18.0.0",
    "eslint-import-resolver-typescript": "3.7.0",
    "eslint-plugin-import": "2.31.0",
    "knip": "6.45.1",
    "tsx": "4.23.15"
  },
  "overrides": {
    "@qdrant/js-client-rest": {
      "undici": "7.30.2"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  }
}
