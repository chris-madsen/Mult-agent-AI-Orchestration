{
  "name": "ace-harness",
  "version": "0.1.0",
  "private": true,
  "description": "Adaptive Context Engine foundation",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "mcp:stdio": "npm run build && node dist/bin/ace-mcp.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test --ext .ts --max-warnings=0",
    "probe:providers": "node scripts/provider-capability-probe.mjs",
    "report:harbor-smoke": "tsx scripts/render-harbor-smoke-report.ts",
    "report:harbor-paired": "tsx scripts/render-harbor-paired-report.ts",
    "report:harbor-retrieval": "tsx scripts/render-harbor-retrieval-report.ts",
    "spike:embeddings": "tsx scripts/embedding-spike.ts",
    "recall:codex-history": "tsx scripts/recall-codex-history.ts",
    "probe:vertex": "bash scripts/vertex-rag-readonly-probe.sh",
    "test:real-provider": "npm run build && node scripts/real-provider-e2e.mjs",
    "test:real-provider-race": "npm run build && ACE_REAL_PROVIDER_RACE=true node scripts/real-provider-e2e.mjs",
    "test:real-provider-outage": "npm run build && ACE_REAL_PROVIDER_OUTAGE=true node scripts/real-provider-e2e.mjs",
    "test:real-provider-restart": "npm run build && node scripts/real-provider-restart-e2e.mjs",
    "test:memory-process": "npm run build && node scripts/memory-process-e2e.mjs",
    "test:real-semantic": "npm run build && node scripts/real-semantic-retrieval-e2e.mjs",
    "probe:jev": "bash scripts/jev-readonly-probe.sh",
    "test": "npm run check && tsx --test test/*.test.ts",
    "memory:sync": "npm run build && node dist/bin/ace-memory.js",
    "gate:harbor": "tsx scripts/harbor-retrieval-gate.ts",
    "test:real-same-name": "npm run build && tsx scripts/real-same-name-lsp-e2e.ts",
    "test:container-provider": "npm run build && node scripts/container-provider-e2e.mjs",
    "compare:embeddings": "bash scripts/embedding-provider-comparison.sh",
    "test:real-provider-hard-outage": "npm run build && ACE_REAL_PROVIDER_HARD_OUTAGE=true node scripts/real-provider-e2e.mjs",
    "memory:reconcile": "npm run build && node dist/bin/ace-memory.js reconcile",
    "worktree-helper": "npm run build && node dist/bin/ace-worktree-helper.js",
    "eval:memory-admission": "tsx scripts/memory-admission-eval.ts",
    "gate:harbor-three-arm": "tsx scripts/harbor-three-arm-gate.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "effect": "3.22.3",
    "typescript": "5.9.3",
    "zod": "4.6.7",
    "@modelcontextprotocol/client": "2.3.1"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "eslint": "8.57.1",
    "eslint-config-airbnb-typescript": "18.0.0",
    "eslint-import-resolver-typescript": "3.7.0",
    "eslint-plugin-import": "2.31.0",
    "tsx": "4.23.15"
  }
}
