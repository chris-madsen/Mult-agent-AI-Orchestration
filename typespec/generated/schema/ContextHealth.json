{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "ContextHealth.json",
    "type": "object",
    "properties": {
        "schemaVersion": {
            "type": "string",
            "const": "ace.context.v3"
        },
        "liveness": {
            "type": "string",
            "const": "ready"
        },
        "readiness": {
            "type": "string",
            "const": "adapter_implemented"
        },
        "providerWire": {
            "type": "string",
            "const": "not_certified"
        }
    },
    "required": [
        "schemaVersion",
        "liveness",
        "readiness",
        "providerWire"
    ],
    "unevaluatedProperties": {
        "not": {}
    }
}