{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "ProjectionRequest.json",
    "type": "object",
    "properties": {
        "schemaVersion": {
            "type": "string",
            "const": "ace.gateway.v1"
        },
        "requestId": {
            "type": "string",
            "minLength": 1
        },
        "attemptGroupId": {
            "type": "string",
            "minLength": 1
        },
        "agentSessionId": {
            "type": "string",
            "minLength": 1
        },
        "workspaceId": {
            "type": "string",
            "minLength": 1
        },
        "dataClass": {
            "anyOf": [
                {
                    "type": "string",
                    "const": "private"
                },
                {
                    "type": "string",
                    "const": "project_document"
                },
                {
                    "type": "string",
                    "const": "public"
                }
            ]
        },
        "protocol": {
            "type": "string",
            "const": "openai.chat.completions"
        },
        "provider": {
            "type": "string",
            "minLength": 1
        },
        "model": {
            "type": "string",
            "minLength": 1
        },
        "bodyBase64": {
            "type": "string",
            "maxLength": 5592408,
            "pattern": "^[A-Za-z0-9+/]+={0,2}$"
        },
        "bodySha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
        },
        "query": {
            "type": "string",
            "minLength": 1
        },
        "projectionMode": {
            "anyOf": [
                {
                    "type": "string",
                    "const": "native"
                },
                {
                    "type": "string",
                    "const": "gateway"
                },
                {
                    "type": "string",
                    "const": "assist-only"
                },
                {
                    "type": "string",
                    "const": "observe-only"
                },
                {
                    "type": "string",
                    "const": "off"
                }
            ]
        },
        "deadlineEpochMs": {
            "type": "integer",
            "minimum": 1
        },
        "attestation": {
            "$ref": "#/$defs/HostCompactionAttestation"
        },
        "nativeProjectionActive": {
            "type": "boolean"
        },
        "requestedEvidenceIds": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/EvidenceId"
            },
            "uniqueItems": true
        }
    },
    "required": [
        "schemaVersion",
        "requestId",
        "attemptGroupId",
        "agentSessionId",
        "workspaceId",
        "dataClass",
        "protocol",
        "provider",
        "model",
        "bodyBase64",
        "bodySha256",
        "query",
        "projectionMode",
        "deadlineEpochMs",
        "attestation"
    ],
    "unevaluatedProperties": {
        "not": {}
    },
    "$defs": {
        "HostCompactionAttestation": {
            "type": "object",
            "properties": {
                "hostBuildDigest": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                },
                "sessionId": {
                    "type": "string",
                    "minLength": 1
                },
                "parentSessionId": {
                    "type": "string",
                    "minLength": 1
                },
                "activeEngineId": {
                    "type": "string",
                    "minLength": 1
                },
                "effectiveCompressionControlsDigest": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                },
                "durableActiveTranscriptRevision": {
                    "type": "string",
                    "minLength": 1
                },
                "durableActiveTranscriptDigest": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                },
                "hostCompactionEpoch": {
                    "anyOf": [
                        {
                            "type": "integer"
                        },
                        {
                            "type": "string",
                            "const": "unknown"
                        }
                    ],
                    "minimum": 0
                },
                "attestorId": {
                    "type": "string",
                    "minLength": 1
                },
                "providerManagedHistoryCapability": {
                    "anyOf": [
                        {
                            "type": "string",
                            "const": "visible"
                        },
                        {
                            "type": "string",
                            "const": "hidden"
                        },
                        {
                            "type": "string",
                            "const": "unknown"
                        }
                    ]
                },
                "hostTranscriptAttested": {
                    "type": "boolean"
                },
                "compactionEnabled": {
                    "type": "boolean"
                }
            },
            "required": [
                "hostBuildDigest",
                "sessionId",
                "activeEngineId",
                "effectiveCompressionControlsDigest",
                "durableActiveTranscriptRevision",
                "durableActiveTranscriptDigest",
                "hostCompactionEpoch",
                "attestorId",
                "providerManagedHistoryCapability",
                "hostTranscriptAttested",
                "compactionEnabled"
            ],
            "unevaluatedProperties": {
                "not": {}
            },
            "description": "Checked by the existing application validator; string constraints are wire-only."
        },
        "EvidenceId": {
            "type": "string",
            "minLength": 1
        }
    }
}