{
  "name": "@ace/context-contract-codegen",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Pinned TypeSpec + OpenAPI SDK generation isolated from ACE runtime",
  "scripts": {
    "generate:tsp": "tsp compile ./context-v3.tsp",
    "generate:sdk": "openapi-ts -i ./generated/openapi.json -o ./generated/sdk",
    "generate": "npm run clean:generated && npm run generate:tsp && npm run generate:sdk && npm run generate:server-types",
    "check:sdk": "tsc --noEmit --project tsconfig.sdk.json",
    "check:native-responses": "node scripts/check-native-responses.mjs && npm run check:context-v3",
    "generate:server-types": "node scripts/sync-server-types.mjs",
    "clean:generated": "node scripts/clean-generated.mjs",
    "check:context-v3": "tsp compile ./context-v3.tsp --no-emit"
  },
  "devDependencies": {
    "@typespec/compiler": "1.17.0",
    "@typespec/http": "1.17.0",
    "@typespec/json-schema": "1.17.0",
    "@typespec/openapi3": "1.17.0",
    "@hey-api/openapi-ts": "0.99.0",
    "@typespec/openapi": "1.17.0",
    "typescript": "5.9.3",
    "ajv": "8.20.0"
  }
}
