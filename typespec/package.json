{
  "name": "@ace/gateway-contract-codegen",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Pinned TypeSpec + OpenAPI SDK generation isolated from ACE runtime",
  "scripts": {
    "generate:tsp": "tsp compile .",
    "generate:sdk": "openapi-ts -i generated/openapi.json -o generated/sdk",
    "generate": "npm run generate:tsp && npm run generate:sdk"
  },
  "devDependencies": {
    "@typespec/compiler": "1.17.0",
    "@typespec/http": "1.17.0",
    "@typespec/json-schema": "1.17.0",
    "@typespec/openapi3": "1.17.0",
    "@hey-api/openapi-ts": "0.99.0",
    "@typespec/openapi": "1.17.0",
    "typescript": "5.9.3"
  }
}
