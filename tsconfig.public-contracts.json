{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": ".cache/tsconfig.public-contracts.tsbuildinfo"
  },
  "include": [
    "src/**/*.ts",
    "test/public-contract-compatibility.contracts.test.ts",
    "test/typespec-gateway-type-coverage.typecheck.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
