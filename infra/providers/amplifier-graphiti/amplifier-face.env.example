# Source this file only after installing the pinned upstream packages.
# The OAuth cache remains outside the repository at ~/.amplifier/.
export AMPLIFIER_AGENT_PROVIDER="openai-chatgpt"
export AMPLIFIER_AGENT_MODEL="${ACE_AMPLIFIER_MODEL_ID:-gpt-5.6-luna}"
export AMPLIFIER_AGENT_FACE_MODEL="${ACE_AMPLIFIER_FACE_MODEL:-$AMPLIFIER_AGENT_MODEL}"
export AMPLIFIER_AGENT_FACE_BIND="127.0.0.1"
export AMPLIFIER_AGENT_FACE_PORT="${ACE_AMPLIFIER_FACE_PORT:-9099}"
export AMPLIFIER_AGENT_APPROVALS="deny"
export AMPLIFIER_AGENT_FACE_TOKEN="${AMPLIFIER_AGENT_FACE_TOKEN:?Generate a local bearer token in the shell; never commit it}"
